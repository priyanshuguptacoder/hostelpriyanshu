# ============================================
# HOSTEL MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values.
# For production, add the same variables in the Render dashboard.

# SERVER
NODE_ENV=development
PORT=3000

# DATABASE
MONGODB_URI=mongodb://localhost:27017/hostel_management

# JWT AUTHENTICATION
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRE=7d

# ============================================
# EMAIL CONFIGURATION - BREVO
# ============================================
# Create an API key in Brevo → SMTP & API → API Keys.
# Verify the sender email in Brevo before sending.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender@example.com
BREVO_FROM_NAME=Hostel Management System

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/google-callback.html

# Production example:
# GOOGLE_REDIRECT_URI=https://your-app.onrender.com/google-callback.html

# ============================================
# CORS CONFIGURATION (Production)
# ============================================
# ALLOWED_ORIGINS=https://your-app.onrender.com,https://your-custom-domain.com

# ============================================
# RENDER NOTES
# ============================================
# Add MONGODB_URI, JWT_SECRET, BREVO_API_KEY,
# BREVO_FROM_EMAIL, BREVO_FROM_NAME and GOOGLE_* variables
# in Render → Environment.
